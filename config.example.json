{
  "ceph": {
    "transport": "local",
    "command": ["ceph"],
    "rbd_command": ["rbd"],
    "rgw_command": ["radosgw-admin"],
    "rgw_pool_prefix": "default",
    "coordination": "active-manager"
  },
  "vault": {
    "address": "https://vault.example.com:8200",
    "namespace": "example",
    "mount": "service-secrets",
    "path_prefix": "rook-pve/staging",
    "token_env": "VAULT_TOKEN",
    "token_file": ""
  },
  "rook_cluster_name": "rook-ceph",
  "cephx_generation": 0,
  "credentials": [
    {
      "vault_path": "rook-ceph-mon",
      "entity": "client.healthchecker",
      "kind": "rook-mon"
    },
    {
      "vault_path": "rook-ceph-config",
      "entity": "",
      "kind": "rook-config"
    },
    {
      "vault_path": "rook-csi-rbd-node",
      "entity": "client.csi-rbd-node",
      "kind": "rook-csi"
    },
    {
      "vault_path": "rook-csi-rbd-provisioner",
      "entity": "client.csi-rbd-provisioner",
      "kind": "rook-csi"
    },
    {
      "vault_path": "rook-csi-cephfs-node",
      "entity": "client.csi-cephfs-node",
      "kind": "rook-cephfs-csi"
    },
    {
      "vault_path": "rook-csi-cephfs-provisioner",
      "entity": "client.csi-cephfs-provisioner",
      "kind": "rook-cephfs-csi"
    }
  ]
}
